.page {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-lg);
  max-width: 900px;
  margin: 0 auto;
  width: 100%;
}

/* Header */
.header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: var(--spacing-lg);
  flex-wrap: wrap;
}

.headerInfo {
  flex: 1;
}

.backButton {
  background: transparent;
  color: var(--color-text-secondary);
  padding: var(--spacing-xs) 0;
  font-size: var(--font-size-sm);
  margin-bottom: var(--spacing-sm);
}

.backButton:hover {
  color: var(--color-text);
}

.title {
  margin: 0 0 var(--spacing-sm) 0;
  font-size: var(--font-size-xl);
}

.meta {
  display: flex;
  align-items: center;
  gap: var(--spacing-md);
  flex-wrap: wrap;
}

.clientName {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
}

.headerActions {
  display: flex;
  gap: var(--spacing-sm);
  flex-wrap: wrap;
}

.viewPublicButton {
  background-color: var(--color-bg-card);
  color: var(--color-primary);
  border: 1px solid var(--color-primary);
  padding: var(--spacing-sm) var(--spacing-md);
  font-size: var(--font-size-sm);
}

.viewPublicButton:hover {
  background-color: var(--color-primary);
  color: white;
}

.copyLinkButton {
  background-color: var(--color-bg-card);
  color: var(--color-text);
  border: 1px solid var(--color-border);
  padding: var(--spacing-sm) var(--spacing-md);
  font-size: var(--font-size-sm);
}

.copyLinkButton:hover {
  background-color: var(--color-bg-hover);
}

.editButton {
  background-color: var(--color-primary);
  color: white;
  padding: var(--spacing-sm) var(--spacing-md);
  font-size: var(--font-size-sm);
}

.editButton:hover {
  background-color: var(--color-primary-hover);
}

.addCandidateButton {
  background-color: var(--color-success, #22c55e);
  color: white;
  padding: var(--spacing-sm) var(--spacing-md);
  font-size: var(--font-size-sm);
  font-weight: 500;
  border: none;
  border-radius: var(--radius-md);
  cursor: pointer;
  transition: background-color 0.15s;
}

.addCandidateButton:hover {
  background-color: #16a34a;
}

.exportButton {
  background-color: var(--color-bg-card);
  color: var(--color-text);
  border: 1px solid var(--color-border);
  padding: var(--spacing-sm) var(--spacing-md);
  font-size: var(--font-size-sm);
}

.exportButton:hover {
  background-color: var(--color-bg-hover);
  border-color: var(--color-border-dark);
}

/* Summary Stats */
.summaryStats {
  display: flex;
  gap: var(--spacing-md);
  flex-wrap: wrap;
}

.statCard {
  background-color: var(--color-bg-card);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: var(--spacing-md) var(--spacing-lg);
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 120px;
}

.statCardHighlight {
  background-color: var(--color-primary-light);
  border-color: var(--color-primary);
}

.statNumber {
  font-size: var(--font-size-2xl);
  font-weight: 700;
  color: var(--color-text);
}

.statCardHighlight .statNumber {
  color: var(--color-primary);
}

.statLabel {
  font-size: var(--font-size-xs);
  color: var(--color-text-secondary);
  text-transform: uppercase;
  letter-spacing: 0.5px;
  margin-top: var(--spacing-xs);
}

/* Filter Section */
.filterSection {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-sm);
  background-color: var(--color-bg-card);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: var(--spacing-md);
}

.filterHeader {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--spacing-sm);
  flex-wrap: wrap;
}

.filterHeaderRight {
  display: flex;
  align-items: center;
  gap: var(--spacing-md);
}

.persistCheckbox {
  display: flex;
  align-items: center;
  gap: var(--spacing-xs);
  font-size: var(--font-size-xs);
  color: var(--color-text-secondary);
  cursor: pointer;
  user-select: none;
}

.persistCheckbox input[type="checkbox"] {
  width: 14px;
  height: 14px;
  accent-color: var(--color-primary);
  cursor: pointer;
}

.persistCheckbox:hover {
  color: var(--color-text);
}

.filterToggleButton {
  display: flex;
  align-items: center;
  gap: var(--spacing-xs);
  background: transparent;
  color: var(--color-text-secondary);
  padding: var(--spacing-xs) var(--spacing-sm);
  font-size: var(--font-size-sm);
  border-radius: var(--radius-md);
  transition: all var(--transition-fast);
}

.filterToggleButton:hover {
  background-color: var(--color-bg-hover);
  color: var(--color-text);
}

.filterToggleActive {
  background-color: var(--color-primary-light);
  color: var(--color-primary);
}

.filterIcon {
  font-size: var(--font-size-base);
}

.activeFilterCount {
  background-color: var(--color-primary);
  color: white;
  font-size: var(--font-size-xs);
  padding: 1px 6px;
  border-radius: var(--radius-full);
  font-weight: 600;
}

.clearFiltersButton {
  background: transparent;
  color: var(--color-danger);
  font-size: var(--font-size-sm);
  padding: var(--spacing-xs) var(--spacing-sm);
}

.clearFiltersButton:hover {
  text-decoration: underline;
}

.searchContainer {
  position: relative;
  display: flex;
  align-items: center;
}

.searchInput {
  width: 100%;
  padding: var(--spacing-sm) var(--spacing-md);
  padding-right: var(--spacing-xl);
  font-size: var(--font-size-sm);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  background-color: var(--color-bg);
  color: var(--color-text);
}

.searchInput:focus {
  outline: none;
  border-color: var(--color-primary);
  box-shadow: 0 0 0 2px var(--color-primary-light);
}

.searchInput::placeholder {
  color: var(--color-text-muted);
}

.clearSearchButton {
  position: absolute;
  right: var(--spacing-sm);
  background: transparent;
  color: var(--color-text-secondary);
  font-size: var(--font-size-lg);
  padding: 0;
  width: 24px;
  height: 24px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-full);
}

.clearSearchButton:hover {
  background-color: var(--color-bg-hover);
  color: var(--color-text);
}

/* Active filters bar */
.activeFiltersBar {
  display: flex;
  align-items: flex-start;
  gap: var(--spacing-sm);
  padding: var(--spacing-sm) 0;
  flex-wrap: wrap;
}

.activeFiltersLabel {
  font-size: var(--font-size-xs);
  color: var(--color-text-secondary);
  font-weight: 500;
  padding-top: 4px;
  flex-shrink: 0;
}

.activeFiltersList {
  display: flex;
  flex-wrap: wrap;
  gap: var(--spacing-xs);
}

.activeFilterTag {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  padding: 4px 8px;
  padding-right: 4px;
  background-color: var(--color-primary);
  color: white;
  border-radius: var(--radius-full);
  font-size: var(--font-size-xs);
  font-weight: 500;
}

.removeFilterButton {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 18px;
  height: 18px;
  padding: 0;
  margin-left: 2px;
  background-color: rgba(255, 255, 255, 0.2);
  border: none;
  border-radius: 50%;
  color: white;
  font-size: 14px;
  line-height: 1;
  cursor: pointer;
  transition: background-color var(--transition-fast);
}

.removeFilterButton:hover {
  background-color: rgba(255, 255, 255, 0.4);
}

.filterPanel {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-md);
  padding-top: var(--spacing-sm);
  border-top: 1px solid var(--color-border);
}

.filterGroup {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-xs);
}

.filterLabelRow {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
}

.filterInputRow {
  display: flex;
  gap: var(--spacing-xs);
}

.filterInput {
  flex: 1;
  padding: var(--spacing-xs) var(--spacing-sm);
  font-size: var(--font-size-sm);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-sm);
  background-color: var(--color-bg);
  color: var(--color-text);
}

.filterInput:focus {
  outline: none;
  border-color: var(--color-primary);
}

.filterInput::placeholder {
  color: var(--color-text-muted);
}

.addFilterButton {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32px;
  height: 32px;
  padding: 0;
  background-color: var(--color-primary);
  color: white;
  border: none;
  border-radius: var(--radius-md);
  font-size: var(--font-size-lg);
  font-weight: 600;
  cursor: pointer;
  transition: background-color var(--transition-fast);
  flex-shrink: 0;
}

.addFilterButton:hover:not(:disabled) {
  background-color: var(--color-primary-hover);
}

.addFilterButton:disabled {
  opacity: 0.4;
  cursor: not-allowed;
}

.addFilterButtonSmall {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 22px;
  height: 22px;
  padding: 0;
  background-color: var(--color-primary-light);
  color: var(--color-primary);
  border: none;
  border-radius: var(--radius-full);
  font-size: var(--font-size-base);
  font-weight: 600;
  cursor: pointer;
  transition: all var(--transition-fast);
}

.addFilterButtonSmall:hover {
  background-color: var(--color-primary);
  color: white;
}

.confirmFilterButton {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32px;
  height: 32px;
  padding: 0;
  background-color: var(--color-success);
  color: white;
  border: none;
  border-radius: var(--radius-sm);
  font-size: var(--font-size-base);
  cursor: pointer;
  transition: background-color var(--transition-fast);
  flex-shrink: 0;
}

.confirmFilterButton:hover:not(:disabled) {
  background-color: var(--color-success-dark, #059669);
}

.confirmFilterButton:disabled {
  opacity: 0.4;
  cursor: not-allowed;
}

.cancelFilterButton {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32px;
  height: 32px;
  padding: 0;
  background-color: var(--color-bg-hover);
  color: var(--color-text-secondary);
  border: none;
  border-radius: var(--radius-sm);
  font-size: var(--font-size-lg);
  cursor: pointer;
  transition: all var(--transition-fast);
  flex-shrink: 0;
}

.cancelFilterButton:hover {
  background-color: var(--color-danger-light);
  color: var(--color-danger);
}

.filterLabel {
  font-size: var(--font-size-xs);
  font-weight: 600;
  color: var(--color-text-secondary);
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.filterOptions {
  display: flex;
  gap: var(--spacing-xs);
  flex-wrap: wrap;
}

.filterOption {
  padding: var(--spacing-xs) var(--spacing-sm);
  font-size: var(--font-size-sm);
  background-color: var(--color-bg);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  color: var(--color-text-secondary);
  transition: all var(--transition-fast);
}

.filterOption:hover {
  border-color: var(--color-border-dark);
  color: var(--color-text);
}

.filterOptionActive {
  background-color: var(--color-primary);
  border-color: var(--color-primary);
  color: white;
}

.filterOptionActive:hover {
  background-color: var(--color-primary-hover);
  border-color: var(--color-primary-hover);
  color: white;
}

.filterChips {
  display: flex;
  gap: var(--spacing-xs);
  flex-wrap: wrap;
}

.filterChip {
  display: inline-flex;
  align-items: center;
  font-size: var(--font-size-xs);
  background-color: var(--color-bg);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-sm);
  color: var(--color-text-secondary);
  transition: all var(--transition-fast);
  overflow: hidden;
}

.filterChip:hover {
  border-color: var(--color-primary);
  color: var(--color-primary);
}

.filterChipLabel {
  padding: var(--spacing-xs) var(--spacing-sm);
  padding-right: 4px;
  background: transparent;
  border: none;
  color: inherit;
  font-size: inherit;
  cursor: pointer;
  transition: color var(--transition-fast);
}

.filterChipLabel:hover {
  color: var(--color-primary);
}

.dismissSuggestionButton {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 20px;
  height: 20px;
  padding: 0;
  margin-right: 2px;
  background-color: transparent;
  border: none;
  border-radius: 50%;
  color: var(--color-text-muted);
  font-size: 14px;
  line-height: 1;
  cursor: pointer;
  transition: all var(--transition-fast);
}

.dismissSuggestionButton:hover {
  background-color: var(--color-danger-light);
  color: var(--color-danger);
}

.filterChipActive {
  background-color: var(--color-primary);
  border-color: var(--color-primary);
  color: white;
}

.filterChipActive:hover {
  background-color: var(--color-primary-hover);
  border-color: var(--color-primary-hover);
  color: white;
}

.filterSubsection {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-xs);
}

.filterSubsectionLabel {
  font-size: var(--font-size-xs);
  color: var(--color-text-muted);
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.filterChipCustom {
  background-color: var(--color-primary-light);
  border-color: var(--color-primary);
}

.filterChipCustom:hover {
  background-color: var(--color-primary-light);
  border-color: var(--color-primary);
}

/* Pipeline section */
.pipelineSection {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-md);
}

.sectionTitle {
  font-size: var(--font-size-lg);
  font-weight: 600;
  color: var(--color-text);
  margin: 0;
}

/* Pipeline Container */
.pipelineContainer {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-md);
}

/* Empty pipeline message */
.emptyPipelineMessage {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--spacing-md) var(--spacing-lg);
  background-color: var(--color-primary-light);
  border: 1px solid var(--color-primary);
  border-radius: var(--radius-lg);
  gap: var(--spacing-md);
}

.emptyPipelineMessage p {
  margin: 0;
  font-size: var(--font-size-sm);
  color: var(--color-primary);
  font-weight: 500;
}

.copyLinkButtonInline {
  background-color: var(--color-primary);
  color: white;
  padding: var(--spacing-xs) var(--spacing-md);
  font-size: var(--font-size-sm);
  border-radius: var(--radius-md);
  white-space: nowrap;
}

.copyLinkButtonInline:hover {
  background-color: var(--color-primary-hover);
}

/* Pipeline Timeline - Vertical */
.pipelineTimeline {
  display: flex;
  flex-direction: column;
  gap: 0;
}

.timelineItem {
  display: flex;
  gap: var(--spacing-md);
  position: relative;
}

.timelineConnector {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 20px;
  flex-shrink: 0;
}

.timelineDot {
  width: 12px;
  height: 12px;
  border-radius: 50%;
  position: relative;
  z-index: 1;
  background-color: var(--color-border);
}

.timelineDotActive {
  background-color: var(--color-text-secondary);
}

.timelineLine {
  width: 2px;
  flex: 1;
  min-height: 20px;
  background-color: var(--color-border);
}

.timelineContent {
  flex: 1;
  padding-bottom: var(--spacing-md);
  min-width: 0;
}

/* Status header button */
.statusHeader {
  width: 100%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--spacing-sm) var(--spacing-md);
  background-color: var(--color-bg-card);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  cursor: pointer;
  transition: all var(--transition-fast);
  text-align: left;
}

.statusHeader:hover:not(:disabled) {
  background-color: var(--color-bg-hover);
  border-color: var(--color-border-dark);
}

.statusHeader:disabled {
  cursor: default;
  opacity: 0.6;
}

.statusHeaderExpanded {
  border-bottom-left-radius: 0;
  border-bottom-right-radius: 0;
  border-bottom-color: transparent;
}

.statusInfo {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-xs);
}

.statusName {
  font-size: var(--font-size-base);
  font-weight: 600;
  color: var(--color-text);
  margin: 0;
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
}

.statusColorDot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  flex-shrink: 0;
}

.emptyStatusText {
  font-size: var(--font-size-xs);
  color: var(--color-text-muted);
  font-style: italic;
}

.statusHeaderEmpty {
  opacity: 0.7;
}

.terminalBadge {
  font-size: var(--font-size-xs);
  font-weight: 500;
  color: var(--color-text-muted);
  background-color: var(--color-bg-hover);
  padding: 1px 6px;
  border-radius: var(--radius-sm);
}

.statusCounts {
  display: flex;
  gap: var(--spacing-sm);
  flex-wrap: wrap;
}

.countBadgeNew {
  font-size: var(--font-size-xs);
  padding: 2px 8px;
  border-radius: var(--radius-full);
  background-color: var(--color-primary-light);
  color: var(--color-primary);
  font-weight: 500;
}

.countBadgeReviewed {
  font-size: var(--font-size-xs);
  padding: 2px 8px;
  border-radius: var(--radius-full);
  background-color: var(--color-bg-hover);
  color: var(--color-text-secondary);
  font-weight: 500;
}

.expandIcon {
  font-size: var(--font-size-xs);
  color: var(--color-text-secondary);
  transition: transform var(--transition-fast);
}

.expandIconOpen {
  transform: rotate(180deg);
}

/* Candidate list (expanded) */
.candidateList {
  border: 1px solid var(--color-border);
  border-top: none;
  border-radius: 0 0 var(--radius-md) var(--radius-md);
  background-color: var(--color-bg);
  overflow: hidden;
}

.candidateItem {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--spacing-sm) var(--spacing-md);
  cursor: pointer;
  transition: background-color var(--transition-fast);
  border-bottom: 1px solid var(--color-border);
}

.candidateItem:last-child {
  border-bottom: none;
}

.candidateItem:hover {
  background-color: var(--color-bg-hover);
}

.candidateItemNew {
  background-color: var(--color-primary-light);
}

.candidateItemNew:hover {
  background-color: #dbeafe;
}

.candidateInfo {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
  min-width: 0;
  flex: 1;
}

.newIndicator {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background-color: var(--color-primary);
  flex-shrink: 0;
  animation: pulse 2s infinite;
}

@keyframes pulse {
  0%, 100% {
    opacity: 1;
  }
  50% {
    opacity: 0.5;
  }
}

.candidateDetails {
  min-width: 0;
  flex: 1;
}

.candidateName {
  font-size: var(--font-size-sm);
  font-weight: 500;
  color: var(--color-text);
  margin: 0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.candidateEmail {
  font-size: var(--font-size-xs);
  color: var(--color-text-muted);
  margin: 0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.viewArrow {
  color: var(--color-text-secondary);
  font-size: var(--font-size-base);
  flex-shrink: 0;
}

/* Empty states */
.emptyPipeline {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-2xl);
  text-align: center;
  background-color: var(--color-bg-card);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
}

.emptyPipeline h3 {
  margin-bottom: var(--spacing-md);
  color: var(--color-text);
  font-size: var(--font-size-lg);
}

/* Status badges */
.statusActive {
  background-color: var(--color-success-light);
  color: #065f46;
}

.statusPaused {
  background-color: var(--color-warning-light);
  color: #92400e;
}

/* Loading */
.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-2xl);
  gap: var(--spacing-md);
}

.loadingSpinner {
  width: 40px;
  height: 40px;
  border: 3px solid var(--color-border);
  border-top-color: var(--color-primary);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

/* Error */
.error {
  background-color: var(--color-danger-light);
  border: 1px solid var(--color-danger);
  border-radius: var(--radius-lg);
  padding: var(--spacing-lg);
  color: #991b1b;
}

.error h3 {
  color: #991b1b;
  margin-bottom: var(--spacing-sm);
}

.retryButton {
  margin-top: var(--spacing-md);
  background-color: var(--color-danger);
  color: white;
}

.retryButton:hover {
  background-color: #dc2626;
}

/* Internal Notes Section */
.notesSection {
  background-color: var(--color-bg-card);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: var(--spacing-md);
}

.notesSectionHeader {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--spacing-md);
}

.notesEditButton {
  background: transparent;
  color: var(--color-primary);
  font-size: var(--font-size-sm);
  padding: var(--spacing-xs) var(--spacing-sm);
  border-radius: var(--radius-md);
}

.notesEditButton:hover {
  background-color: var(--color-primary-light);
}

.notesEditor {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-sm);
}

.notesTextarea {
  width: 100%;
  padding: var(--spacing-sm);
  font-size: var(--font-size-sm);
  font-family: inherit;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  background-color: var(--color-bg);
  color: var(--color-text);
  resize: vertical;
  min-height: 100px;
}

.notesTextarea:focus {
  outline: none;
  border-color: var(--color-primary);
  box-shadow: 0 0 0 2px var(--color-primary-light);
}

.notesTextarea:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}

.notesError {
  color: var(--color-danger);
  font-size: var(--font-size-sm);
  margin: 0;
}

.notesActions {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: var(--spacing-sm);
}

.notesActionsRight {
  display: flex;
  gap: var(--spacing-sm);
}

.notesCancelButton {
  background: transparent;
  color: var(--color-text-secondary);
  padding: var(--spacing-xs) var(--spacing-md);
  font-size: var(--font-size-sm);
  border-radius: var(--radius-md);
}

.notesCancelButton:hover {
  background-color: var(--color-bg-hover);
  color: var(--color-text);
}

.notesSaveButton {
  background-color: var(--color-primary);
  color: white;
  padding: var(--spacing-xs) var(--spacing-md);
  font-size: var(--font-size-sm);
  border-radius: var(--radius-md);
}

.notesSaveButton:hover:not(:disabled) {
  background-color: var(--color-primary-hover);
}

.notesSaveButton:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}

.notesDeleteButton {
  background: transparent;
  color: var(--color-danger);
  padding: var(--spacing-xs) var(--spacing-md);
  font-size: var(--font-size-sm);
  border-radius: var(--radius-md);
}

.notesDeleteButton:hover:not(:disabled) {
  background-color: var(--color-danger-light);
}

.notesDeleteButton:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}

.notesContent {
  background-color: var(--color-bg);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  padding: var(--spacing-md);
}

.notesText {
  margin: 0;
  font-size: var(--font-size-sm);
  color: var(--color-text);
  white-space: pre-wrap;
  line-height: 1.6;
}

.notesEmpty {
  text-align: center;
  padding: var(--spacing-md);
  color: var(--color-text-muted);
  font-size: var(--font-size-sm);
}

.notesEmpty p {
  margin: 0;
}

/* Toast notification */
.toast {
  position: fixed;
  bottom: var(--spacing-lg);
  right: var(--spacing-lg);
  background-color: var(--color-text);
  color: white;
  padding: var(--spacing-sm) var(--spacing-lg);
  border-radius: var(--radius-md);
  font-size: var(--font-size-sm);
  animation: fadeIn 0.2s ease;
  z-index: 1000;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(10px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* Export confirmation modal */
.modalOverlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  animation: fadeIn 0.15s ease;
}

.confirmModal {
  background-color: var(--color-bg-card);
  border-radius: var(--radius-lg);
  padding: var(--spacing-lg);
  max-width: 420px;
  width: 90%;
  box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
}

.confirmModal h3 {
  margin: 0 0 var(--spacing-sm) 0;
  font-size: var(--font-size-lg);
  color: var(--color-text);
}

.confirmModal p {
  margin: 0 0 var(--spacing-md) 0;
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
}

.exportDataList {
  margin: 0 0 var(--spacing-lg) 0;
  padding-left: var(--spacing-lg);
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
}

.exportDataList li {
  margin-bottom: var(--spacing-xs);
}

.confirmActions {
  display: flex;
  gap: var(--spacing-sm);
  justify-content: flex-end;
}

.cancelButton {
  background: transparent;
  color: var(--color-text-secondary);
  padding: var(--spacing-sm) var(--spacing-md);
  font-size: var(--font-size-sm);
  border-radius: var(--radius-md);
}

.cancelButton:hover {
  background-color: var(--color-bg-hover);
  color: var(--color-text);
}

.confirmButton {
  background-color: var(--color-primary);
  color: white;
  padding: var(--spacing-sm) var(--spacing-md);
  font-size: var(--font-size-sm);
  border-radius: var(--radius-md);
}

.confirmButton:hover {
  background-color: var(--color-primary-hover);
}

/* Mobile responsive */
@media (max-width: 640px) {
  .page {
    gap: var(--spacing-md);
  }

  .header {
    flex-direction: column;
    gap: var(--spacing-md);
  }

  .headerActions {
    width: 100%;
  }

  .headerActions button {
    flex: 1;
  }

  .title {
    font-size: var(--font-size-lg);
  }

  .summaryStats {
    width: 100%;
  }

  .statCard {
    flex: 1;
    min-width: 0;
    padding: var(--spacing-sm) var(--spacing-md);
  }

  .statNumber {
    font-size: var(--font-size-xl);
  }

  .timelineConnector {
    width: 16px;
  }

  .timelineDot {
    width: 10px;
    height: 10px;
  }

  .statusHeader {
    padding: var(--spacing-sm);
  }

  .statusName {
    font-size: var(--font-size-sm);
  }

  .candidateItem {
    padding: var(--spacing-sm);
  }

  .toast {
    left: var(--spacing-md);
    right: var(--spacing-md);
    bottom: var(--spacing-md);
    text-align: center;
  }
}
